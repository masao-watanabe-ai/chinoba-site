# Files excluded from Cloudflare Workers static-asset uploads.
# Uses .gitignore-style syntax. Keeps internal/tooling files out of the
# deployed site while preserving all real static assets and routes.

# Version control
.git/**

# Wrangler local state and build output
.wrangler/**

# OS cruft
.DS_Store
**/.DS_Store

# Logs and temporary files
*.log
*.tmp
*~

# Worker source and project config (served by the runtime, not as assets)
worker.js
wrangler.jsonc
.gitignore
.assetsignore
.dev.vars*
.env*
node_modules/**

# Research source material: EPUB manuscripts and topic drafts (not for public delivery).
# Both capitalisations exist on disk and matching is case-sensitive.
research/*/Book/**
research/*/book/**
research/*/topic/**
# No EPUB manuscripts are linked from any page; keep them out of delivery wherever they sit.
research/**/*.epub
